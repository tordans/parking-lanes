# Copy to `.env` and fill in. Webpack injects OSM_OAUTH_CLIENT_ID at build time via DefinePlugin.

# OAuth 2 — https://www.openstreetmap.org/oauth2/applications/new
#
# Register these redirect URIs on the OSM app (exact match, one line each):
#   http://127.0.0.1:33444/osm-oauth-land.html              (local dev — webpack-dev-server port)
#   https://zlant.github.io/parking-lanes/osm-oauth-land.html (GitHub Pages production)
#
# IMPORTANT — "Confidential application?" must be UNCHECKED (public client).
# SPAs / browser apps cannot keep a client secret; osm-api uses PKCE only.
#
# Enable scopes on the OSM app (must match what the app requests):
#   read_prefs — user display name via getUser('me')
#   write_api — upload changesets
#
# Local: open the app at http://127.0.0.1:33444 (not http://localhost:33444) so
# window.location.origin matches the registered redirect URI.
OSM_OAUTH_CLIENT_ID=
