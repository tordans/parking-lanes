# Copy to `.env` at the repo root. Public PKCE clients — no client secret.
# Create apps at openstreetmap.org/oauth2/applications (uncheck "Confidential application").
# Scopes: read_prefs + write_api. Run dev at http://127.0.0.1:33444/ (not localhost).
#
# Register these redirect URIs (exact match) on each OAuth app:
#   http://127.0.0.1:33444/street-space-editor/osm-oauth-land.html
#   https://osmberlin.github.io/street-space-editor/osm-oauth-land.html

# www.openstreetmap.org (default)
OSM_OAUTH_CLIENT_ID=WmTSsQVfDq0vkM1tbLahyohhowiL0AWHFFp5u5BkJe4

# master.apis.dev.openstreetmap.org — Debug → "Use OSM dev server" (separate OAuth app)
OSM_OAUTH_CLIENT_ID_DEV=
