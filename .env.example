# Copy to `.env` for local notes. Client IDs are hardcoded in
# `app/src/lib/osmOAuth.const.ts` (public PKCE clients; no secret).
#
# IMPORTANT — "Confidential application?" must be UNCHECKED (public client).
# Scopes: read_prefs + write_api
#
# Open the app at http://127.0.0.1:33444/… (not localhost) so the redirect
# origin matches the registered URI.

# ── Production OSM (www.openstreetmap.org) ─────────────────────────────
# https://www.openstreetmap.org/oauth2/applications
# App name: street-parking-editor (rename later if desired)
#
# Redirect URIs (exact match, one line each):
#   http://127.0.0.1:33444/street-space-editor/osm-oauth-land.html
#   https://osmberlin.github.io/street-space-editor/osm-oauth-land.html
#   http://127.0.0.1:33444/street-parking-editor/osm-oauth-land.html
#   https://osmberlin.github.io/street-parking-editor/osm-oauth-land.html
#
OSM_OAUTH_CLIENT_ID=

# ── Dev OSM API (master.apis.dev.openstreetmap.org) ────────────────────
# Used when Debug → "Use OSM dev server" is ON.
# Register redirect URIs on a SEPARATE app here (not on www.openstreetmap.org):
#   https://master.apis.dev.openstreetmap.org/oauth2/applications
#
# Redirect URIs (same paths as production):
#   http://127.0.0.1:33444/street-space-editor/osm-oauth-land.html
#   https://osmberlin.github.io/street-space-editor/osm-oauth-land.html
#
OSM_OAUTH_CLIENT_ID_DEV=
