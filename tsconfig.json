{
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts"],
  "exclude": ["node_modules", "dist", "src/test/**", "node_modules/osm-parking-tag-updater/**"],
  "compilerOptions": {
    "target": "ES2025",
    "lib": ["ES2025", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "types": ["vite/client", "bun-types"],

    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "verbatimModuleSyntax": false,
    "noEmit": true,

    "strict": true,
    "noImplicitOverride": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noUncheckedSideEffectImports": true,
    "noUncheckedIndexedAccess": false,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "tsBuildInfoFile": ".tsbuildinfo-app",
    "noErrorTruncation": true,

    "paths": {
      "@/*": ["./src/*"],
      "osm-parking-tag-updater/src/components/Tool/transpose/transpose": [
        "./src/shims/osm-tag-updater-transpose.ts"
      ]
    }
  }
}
