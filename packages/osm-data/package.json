{
  "name": "@osm-editor-kit/osm-data",
  "version": "0.1.0-alpha.0",
  "description": "Download, parse, and merge OSM API/Overpass responses into an indexed in-memory store.",
  "license": "MIT",
  "author": "Tobias Jordans",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/osmberlin/street-space-editor.git",
    "directory": "packages/osm-data"
  },
  "homepage": "https://github.com/osmberlin/street-space-editor/tree/main/packages/osm-data",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "scripts": {
    "build": "tsup && rm -f .tsbuildinfo && tsc -p tsconfig.build.json",
    "type-check": "tsc --noEmit",
    "test-run": "bun test src/test",
    "prepublishOnly": "bun run build && bun ../../scripts/package-exports-for-publish.ts",
    "postpublish": "bun ../../scripts/package-exports-restore.ts",
    "prepack": "bun ../../scripts/package-exports-for-publish.ts",
    "postpack": "bun ../../scripts/package-exports-restore.ts"
  },
  "dependencies": {
    "axios": "^1.11.0"
  },
  "devDependencies": {
    "bun-types": "^1.2.20",
    "tsup": "^8.5.1",
    "typescript": "^7.0.0"
  },
  "publishExports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  }
}
